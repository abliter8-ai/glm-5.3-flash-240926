# IP-285 — fleet serving config for GLM-5.3-Flash EXL3 TR3 4bpw on the dual-GB10 pair.
#
# METHOD (David, 2026-09-01): model this from the MiaAI recipe FAITHFULLY. Do not contaminate
# the baseline with our own preferences, or the numbers stop being comparable — to their
# published results OR between our own runs. Deltas are allowed only where they are
# (a) unavoidable infrastructure with ZERO behavioural effect, or
# (b) a genuinely novel lever we think improves on theirs — and those are OPT-IN VARIANTS,
#     measured one at a time against the faithful baseline, never silently baked in.
#
# Source of truth: miaai-overlay/start.sh @ 0f49cfd since IP-327 (the IP-285 baseline was 493cb88f; values below
# match upstream unless marked).
# Pre-flight: .model-preflight/mia-ailab--glm-5.3-flash-exl3-tr3-4bpw/preflight.md

# =============================================================================
# (a) UNAVOIDABLE INFRASTRUCTURE — different addresses/paths, zero behavioural effect
# =============================================================================
HEAD_IP=__HEAD_IP__                 # their kit: 10.0.0.1 — our CX7 rail-0
WORKER_IP=__WORKER_IP__               # their kit: 10.0.0.2
WORKER_USER=__USER__
PORT=8000                              # theirs: 8888. Pure addressing; cannot affect tok/s or
                                       # quality. 8000 = fleet convention, so existing gateway
                                       # routes/probes make this a drop-in A/B vs the incumbent.
STAGED_DIR=~/.cache/huggingface/staged/glm53-flash-exl3-4bpw
                                       # theirs: HF cache layout. Ours is a flat staged dir +
                                       # bind mount (fleet convention). Same bytes on disk.

# =============================================================================
# THE FAITHFUL BASELINE — every value below is MiaAI's, unchanged. Do not edit
# these to "improve" a run; add a variant below instead and measure it.
# =============================================================================
MODEL=Mia-AiLab/GLM-5.3-Flash-EXL3-TR3-4bpw
MODEL_REVISION=25a44fdbf16862a46b7cc9921142c6c81350af2f
# ROLLBACK image (IP-285 recipe v1; superseded by the IP-289 local build below):
# IMAGE=ghcr.io/miaai-lab/glm-5.3-flash-2x-dgx-sparks@sha256:9bb1557a4234fce63d59599e44d10747eabd742beb337eebf9e7070be8a0fd58
SERVED_MODEL_NAME=glm-5.3-flash-uncensored   # DAVID 2026-09-01: serve under the INCUMBENT'S name so
                                       # every existing gateway route / OWUI / VS Code / Hermes /
                                       # ops-agent consumer works unchanged. With ABLIT=1 this lane
                                       # genuinely IS glm-5.3-flash uncensored, so the name is honest.
                                       # Promotion = leave it running; rollback = boot the NVFP4 lane,
                                       # which answers to the same name. Only one can run (same GPUs),
                                       # so there is no ambiguity about which is live — confirm with
                                       # docker inspect / the recipe recorded in cluster-services.
DFLASH_MODEL=incoai/GLM-5.3-Flash-DFlash2
MASTER_PORT=29521
TP=2
NNODES=2
QUANTIZATION=exl3
KV_CACHE_DTYPE=fp8
SPEC_METHOD=dflash
DFLASH_TOKENS=7
MAX_MODEL_LEN=640000
GPU_MEM_UTIL=0.845                     # IP-289 B2c; the KV pool is PINNED via EXTRA_ARGS since IP-310 (profiler pool varied 693k-760k boot to boot)
MAX_NUM_SEQS=12                        # IP-285 measured knee; with E3 this forces EXL3_TEMP_ROWS_FUSED >= 96
MAX_NUM_BATCHED_TOKENS=7168            # IP-310 L1b: upstream's E3 default (E3 scratch = 57,344 rows); 8192 stays proven on E2 (IP-286/289)
GLM53_MIXED_PREFILL_CHUNK=1024         # DAVID 2026-09-01: VARIANT 5 ON (IP-286 finding 3, see below)
IMAGE=glm53-exl3-local:0f49cfd          # IP-327: LOCALLY BUILT from the re-vendored overlay @ 0f49cfd (sha256:bd4d789050da, stamp e7b9e9a866c217eb); f906ee99 (84213c37e0ac) = v3 rollback
GLM53_INDEXER_WORKSPACE=rightsize      # IP-289 VARIANT 6 ON (B2c). NOTE: on UMA the reclaimed 2.9 GiB is host slack, not free pool — hence gmu 0.845
EXL3_FAT_KERNEL=1                      # IP-289 VARIANT 7 ON (B2c): prefill +12-18% vs v1 measured; decode unchanged vs legacy
GLM53_SPINWAIT_MS=16                   # IP-327: upstream TP2 profile; EngineCore CPU 17.7% of a core vs 99.7% at stock (measured)
# ---- IP-310 (2026-09-12/13) — measured in the v3 results record; every line below is the SERVING posture ----
PORT=8000                              # fleet convention; the IP-310 ladder ran on 8001 so the gateway fell back to zAI
EXL3_FAT_GROUPED=1                     # E3 grouped fat-expert MoE (upstream default). NO measurable prefill gain on this pair at 7168 or 8192; kept as default, every correctness cell passed
EXL3_TEMP_ROWS_FUSED=128               # >= MAX_NUM_SEQS x (DFLASH_TOKENS+1) = 96; upstream's E3 default 32 assumes seqs 4
LONG_PREFILL_TOKEN_THRESHOLD=1024      # item E: a 62k warm session answers in <= 7 s while a 188k cold prefill runs (upstream: 440 s freeze without it)
DFLASH_REVISION=7d74cdd881ed7e32c31175984a67823127b66cfe   # item F: pinned (sha256 8931dc52...); dc77ff1c measured worse (code -7%); bf582e4e staged, not booted
GLM53_ADAPTIVE_K=ema                   # item C; the MARGIN lives in the runtime file ~/.cache/vllm-glm53-flash/glm53_adaptive_k.json = {"mode":"ema","set":"2,4,7","margin":2.0}
GLM53_ADAPTIVE_K_SET=2,4,7             # margin 1.0 (env default) cost code -6%; margin 2.0 = prose +17%, code within 2.5% of k=7
GLM53_DENSE_FP8=dense,kda              # item D: FP8 weight-only Marlin dense+KDA projections. KL vs BF16 0.0061 nats mean / argmax 0.984; decode +11-33% by class; prefill -10%; floor +1.1 GB
LIMIT_MM='{"image":8,"video":1}'       # IP-327: measured-safe on the head (8 x 2048-token images -> 3.29 GiB min; 12 projects < 3 GiB). v3 was 100, upstream 48
EXTRA_ARGS="--enable-prompt-tokens-details --kv-cache-memory-bytes 14495514624 --cudagraph-capture-sizes 1 2 3 4 5 6 8 9 10 12 15 16 20 24 32 40 48 64 80 96"
                                       # KV pinned 13.5 GiB = 721,183 tokens (1.13x at 640k); 20 capture sizes (26 graphs) — CUDA-graph executables are driver memory on GB10, the 35-size union cost ~2 GB of worst-case floor
LANGUAGE_MODEL_ONLY=0                  # vision on
# ---- IP-327 (2026-09-24) — upstream 0f49cfd TP=2 opt-ins, measured against a same-day v3 control (CR-327) ----
GLM53_EXL3_MOE_FAST=1                  # thin-decode routed-expert kernels: structured +7.7%, code +8.8%, prose +6-7%, c12 +7.4%
GLM53_DRAFT_KV_COMPACT=1               # compact DFlash2 pages: 28.7k repeat-prefix 0.43 s (v3 3.93 s); 13.5 GiB pin = 1.42M tokens (2.22x)
GLM53_KDA_BF16_LARGE_M=0               # +9-10% prefill measured, but +3.29 GiB/rank; an 8 GiB pin to fund it cost c12 -31% (each running request holds >= 35 KV blocks)
MM_IMAGE_TOKENS=2048                   # upstream default; 1024 misreads 11-13 px text (2-4/12 vs 10-12/12 exact) - keep for web pages
MM_PROCESSOR_CACHE_GB=1                # upstream default (vLLM 4 GiB)
DEFAULT_MAX_NEW_TOKENS=65536           # upstream default; omitted max_tokens only
LOAD_FORMAT=                           # vLLM auto, NOT instanttensor (IP-314 host floor)
GLM53_EXPOSE_CACHE_RESET=0
# start.sh @ 0f49cfd resets ABLIT=0 after sourcing .env: the BOOT COMMAND must export ABLIT=1 ABLIT_METHOD=transplant
# (RUIN-DELTAS §6). The ABLIT lines below stay for readability; a boot without the export serves the stock checkpoint.
SKIP_MM_PROFILING=1
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
USE_HOST_NCCL=0
REASONING_PARSER=glm45
TOOL_CALL_PARSER=glm47
# Fabric: DAVID 2026-09-01 — VARIANT 1 ON (dual-rail). Upstream ships single-rail
# (CROSS_NIC=0, one HCA); ours is a measured 196 vs 109 Gb/s on this exact pair.
NCCL_IB_GID_INDEX=3
NCCL_DEBUG=WARN
NCCL_IB_HCA=rocep1s0f1,roceP2p1s0f1
NCCL_IB_MERGE_NICS=1
NCCL_CROSS_NIC=0                      # IP-314: reconcile to verified v3 runtime; no fabric change
NCCL_SOCKET_IFNAME=enp1s0f1np1
NCCL_NVLS_ENABLE=0
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1

# Abliteration: DAVID 2026-09-01 — VARIANT 3 ON. Loading straight into production mode because
# the intent is "if it's good, keep it serving"; ABLIT=0 would only ever be a throwaway state
# costing a second ~17 min reload. NOTE the consequence: our numbers are then NOT comparable to
# MiaAI's published figures or the KLD panel (both stock-weight). That is the right trade — the
# decision criterion is our INCUMBENT, which is abliterated, not their claims.
# DONOR = dealignai, i.e. our incumbent's OWN checkpoint, so the o_proj transplant is identical
# to what the NVFP4 lane already serves. This makes the A/B a pure QUANT comparison (EXL3 vs
# NVFP4) instead of quant + a different abliteration source. (drowzeys is byte-identical anyway
# — it is dealign's o_proj copied onto LibertAI shards — but this is cleaner provenance.)
ABLIT=1
ABLIT_METHOD=transplant
ABLIT_LAYERS=15-45
ABLIT_INCLUDE_MTP=1
ABLIT_DONOR=dealignai/GLM-5.3-Flash-UNCENSORED-NVFP4

# Chat template: their launch points --chat-template at the overlay's own file. This is NOT
# our delta — it is their config, and it is load-bearing. The CHECKPOINT's own template
# ignores enable_thinking entirely and blocks vision (pre-flight §5, rendered and verified).
CHAT_TEMPLATE_HOST=./miaai-overlay/files/chat_template.jinja
# NOTE: we deliberately do NOT set --default-chat-template-kwargs in the baseline.
# Their overlay template defaults thinking ON; our incumbent defaults OFF. Forcing our
# default here would silently change what is measured. Thinking state is instead set
# EXPLICITLY per request in every benchmark, so both lanes are compared on stated terms.
# For production serving (not benchmarking) see VARIANT 4.

# =============================================================================
# (b) CANDIDATE VARIANTS — our genuinely novel levers. OPT-IN, one at a time,
#     each measured against the faithful baseline. Enable by exporting the
#     override before launch; never edit the baseline block above.
# =============================================================================
#
# VARIANT 1 — DUAL-RAIL NCCL.  *** ENABLED for first load (David, 2026-09-01) ***
#   Ours is a measured fleet fact: 196 Gb/s dual-rail vs 109 single-rail on this exact pair.
#   Their recipe ships single-rail. TP2 all-reduces once per MoE layer, so interconnect
#   bandwidth is plausibly on the critical path for decode. This is the most likely of our
#   levers to be a free win, and it cannot change output quality — only speed.
#   Enable:
#     NCCL_IB_HCA=rocep1s0f1,roceP2p1s0f1  NCCL_IB_MERGE_NICS=1  NCCL_CROSS_NIC=1 \
#     NCCL_SOCKET_IFNAME=enp1s0f1np1  NCCL_NVLS_ENABLE=0  NCCL_CUMEM_ENABLE=0 \
#     NCCL_IGNORE_CPU_AFFINITY=1
#
# VARIANT 2 — MAX_NUM_BATCHED_TOKENS 8192.  *** ENABLED for first load (David, 2026-09-01) ***
#   On our NVFP4 + DFlash2 lane we MEASURED that vLLM silently caps speculative scheduling
#   at 2048 and that raising this to 8192 took raw-code single-stream 29.4 -> 49.8 tok/s at
#   unchanged acceptance (IP-277). MiaAI ships 2048. If the same cap applies to their stack,
#   they are leaving a large gain on the table and this is a genuine improvement on their
#   recipe — but it MUST be measured here, not assumed to transfer across quant/engine.
#   Watch for the boot warning "max_num_scheduled_tokens is set to 2048 based on the
#   speculative decoding settings" — its presence/absence is the tell.
#   Enable:  MAX_NUM_BATCHED_TOKENS=8192
#
# VARIANT 3 — ABLIT=1 (PRODUCTION MODE, not a performance lever).
#   Applies the drowzeys L15-45 o_proj transplant at weight-load (~2.7 GiB range-fetch,
#   nothing rewritten on disk, no rebuild). This is what we would actually serve, and it is
#   the correct setting when comparing against our incumbent (which is abliterated).
#   It is NOT correct for reproducing MiaAI's or the KLD panel's stock-weight numbers.
#   Upstream warns acceptance can shift after ablit — so re-bench, do not carry numbers over.
#   Expect in the load log: mean rel_l2 ~0.126, L44 outlier ~0.737.
#   Enable:  ABLIT=1  ABLIT_METHOD=transplant  ABLIT_LAYERS=15-45  ABLIT_INCLUDE_MTP=1
#
# VARIANT 5 — GLM53_MIXED_PREFILL_CHUNK 1024 (upstream ships `skip`).  *** ENABLED (David, 2026-09-01) ***
#   Upstream's scheduler patch (issue #6) refuses to mix a new prefill into any step where a
#   peer is decoding, to protect single-stream decode (a mixed step drops the decoder to
#   ~5-10 tok/s on this hardware). The cost is that STAGGERED arrivals serialise: MEASURED
#   under skip, a 21.8k-token caller arriving 5 s into a 1200-token generation got its first
#   token 77.6 s later (56 s waiting + 21 s prefill). Agents arrive staggered. 1024 caps the
#   mixed prefill chunk so the newcomer prefills while the peer decodes slowly for ~20 s.
#   Batch-arrival throughput (llama-benchy, all at t=0) is unaffected by this knob.
#   Enable:  GLM53_MIXED_PREFILL_CHUNK=1024      (skip = upstream; 0 = stock chunked prefill)
#
# VARIANT 6 — GLM53_INDEXER_WORKSPACE=rightsize (upstream PR86, opt-in; ships `stock`).
#   The sparse-indexer prefill gather workspace is sized max_model_len*40 entries x 132 B and
#   LOCKED for the process life, subtracted from the KV pool: 3.15 GiB at our 640k. Right-size =
#   min(max_num_seqs, MNBT) * cdiv(max_model_len + k, 4) = 1.92M entries = 0.24 GiB at seqs 12.
#   Expected: ~+2.9 GiB pool, ~763k -> ~905k hybrid tokens. Lossless (buffer sizing, not KV data).
#   Fail-closed at boot if formula and clamp disagree. Measured value: IP-289 B1 boot.
#   Enable:  GLM53_INDEXER_WORKSPACE=rightsize
#
# VARIANT 7 — EXL3_FAT_KERNEL=1 (upstream PR77 "E2" direct/scatter fat-expert prefill kernels).
#   Upstream: +20-21% fully-uncached prefill at 8k/100k/300k, reproduced on a second kit, at MNBT
#   2048/7168; decode path unchanged. Untested by them at OUR MNBT 8192 -> the IP-289 long-prefill
#   stress repeats under E2. Needs the locally built image (kernel compiled into exllamav3_ext).
#   Enable:  EXL3_FAT_KERNEL=1        (0 = legacy fat path in the same image)
#
# VARIANT 8 — GLM53_SPINWAIT_MS=16 (upstream PR96). +0.95% median decode on their frozen sweep.
#   Keep only if it clears noise here. Enable:  GLM53_SPINWAIT_MS=16
#
# VARIANT 4 — fleet thinking default (PRODUCTION serving only, never for benchmarks).
#   Our fleet default is thinking OFF; the overlay template defaults ON. Set this only when
#   the lane is serving real traffic, so routes behave as callers expect.
#   Enable:  DEFAULT_CHAT_TEMPLATE_KWARGS={"enable_thinking": false}
#
# VARIANT 5 — clear_thinking (capability, untested).
#   Overlay-template feature with no incumbent equivalent: strips prior-turn reasoning from
#   history except after the last user message. Targets the reasoning-accumulation-in-
#   tool-loops failure logged on the DSv4 lane (KI-036). Per-request kwarg, not a launch flag.

# =============================================================================
# FIRST-LOAD CONFIG (David, 2026-09-01) — a SCREENING run, not the faithful baseline
# =============================================================================
# Active deltas from upstream: VARIANT 1 (dual-rail NCCL) + VARIANT 2 (batched 8192).
# ABLIT=1 from the first load (David): it is per-RUNTIME-LOAD, not per-request (verified in
# overlay/ablit_runtime.py: the edit runs at the end of Glm5NextModel.load_weights /
# Glm5NextMTP.load_weights, with no request-scoped path), so switching modes costs a
# full ~17 min reload, so we boot straight into the mode we would actually serve.
#
# Rationale for screening-first: boots are ~17 min each. Running our best-guess config
# first answers the cheapest question — "can this beat the incumbent AT ALL?" If it
# loses even at its best, we stop and never spend the remaining windows. If it wins,
# THEN run the faithful baseline (both variants off) to attribute the gain, since a
# two-variable first run cannot tell us which lever did the work.
#
# The tell for VARIANT 2 is in the boot log: presence/absence of
#   "max_num_scheduled_tokens is set to 2048 based on the speculative decoding settings"
# If that warning is ABSENT at 8192, the cap is lifted exactly as on our NVFP4 lane.
#
# =============================================================================
# KNOWN-BAD (from the overlay README + the quant origin's card) — never set these
# =============================================================================
# NEVER --moe-backend marlin        : that is the NVFP4 path; this is EXL3
# NEVER pin TRITON_ATTN for draft attention : collapses later-position accept to ~0.31
#                                     (position 0 stays healthy, so it is easy to miss)
# NEVER send top-level OpenAI `reasoning_effort` : collides with GLM's nested one
